{
  "meta": {
    "name": "Power Share FlexCo Design System",
    "version": "1.0.0",
    "updated": "2026-10-07"
  },

  "color": {
    "brand": {
      "teal":       { "value": "#0ABAB5", "usage": "Primary brand, CTAs, active states, energy flow" },
      "teal-light": { "value": "#3DD4CF", "usage": "Hover states, secondary accents, right-side gradients" },
      "teal-dark":  { "value": "#089E9A", "usage": "Pressed states, left-side gradients" },
      "amber":      { "value": "#F5A623", "usage": "Solar/generation, lightning bolt, warnings" },
      "amber-light":{ "value": "#FFBF4A", "usage": "Amber hover" }
    },

    "semantic": {
      "green":  { "value": "#34C759", "usage": "Success, battery, positive metrics, live indicator" },
      "coral":  { "value": "#FF6B6B", "usage": "Error, negative metrics, consumption peaks" }
    },

    "neutral": {
      "navy":       { "value": "#1A2332", "usage": "Dark backgrounds, primary text (light mode)" },
      "navy-light": { "value": "#243044", "usage": "Cards on dark bg, elevated dark surfaces" }
    },

    "light-mode": {
      "bg-primary":   { "value": "#FFFFFF", "usage": "Page background" },
      "bg-secondary": { "value": "#F8FAFB", "usage": "Section backgrounds (cloud), cards" },
      "bg-surface":   { "value": "#FFFFFF", "usage": "Card/panel surfaces" },
      "text-primary": { "value": "#111827", "usage": "Headings, primary text" },
      "text-secondary": { "value": "#4B5563", "usage": "Body text, descriptions" },
      "text-muted":   { "value": "#9CA3AF", "usage": "Labels, placeholders, metadata" },
      "border":       { "value": "#E5E7EB", "usage": "Borders, dividers" }
    },

    "dark-mode": {
      "bg-primary":   { "value": "#0F1219", "usage": "Page background" },
      "bg-secondary": { "value": "#161B26", "usage": "Section backgrounds" },
      "bg-surface":   { "value": "#1A2332", "usage": "Card/panel surfaces" },
      "text-primary": { "value": "#F3F4F6", "usage": "Headings, primary text" },
      "text-secondary": { "value": "#D1D5DB", "usage": "Body text, descriptions" },
      "text-muted":   { "value": "#6B7280", "usage": "Labels, placeholders, metadata" },
      "border":       { "value": "rgba(255,255,255,0.1)", "usage": "Borders, dividers" }
    },

    "gradients": {
      "logo-left":  { "from": "#089E9A", "to": "#0ABAB5" },
      "logo-right": { "from": "#0ABAB5", "to": "#3DD4CF" },
      "cta-bg":     { "value": "#0ABAB5", "note": "Solid teal, no gradient" }
    }
  },

  "typography": {
    "font-family": {
      "sans":  "Inter, system-ui, -apple-system, sans-serif",
      "mono":  "JetBrains Mono, Fira Code, monospace"
    },
    "font-weight": {
      "light":     300,
      "regular":   400,
      "medium":    500,
      "semibold":  600,
      "bold":      700,
      "extrabold": 800,
      "black":     900
    },
    "scale": {
      "hero":      { "size": "clamp(2.25rem, 5vw, 3.75rem)", "weight": 700, "leading": "1.1", "tracking": "-0.025em" },
      "h2":        { "size": "clamp(1.875rem, 3vw, 2.25rem)", "weight": 700, "leading": "1.2" },
      "h3":        { "size": "1.25rem", "weight": 700, "leading": "1.3" },
      "body":      { "size": "1rem", "weight": 400, "leading": "1.625" },
      "body-lg":   { "size": "1.125rem", "weight": 400, "leading": "1.6" },
      "small":     { "size": "0.875rem", "weight": 400, "leading": "1.5" },
      "caption":   { "size": "0.75rem", "weight": 500, "leading": "1.4" },
      "label":     { "size": "0.625rem", "weight": 500, "tracking": "0.1em", "transform": "uppercase" },
      "mono-data": { "size": "0.875rem", "weight": 500, "family": "mono" }
    },
    "wordmark": {
      "power-share": { "size": "17px", "weight": 800, "tracking": "-0.025em", "transform": "uppercase" },
      "flexco":      { "size": "10px", "weight": 500, "tracking": "0.25em", "color": "teal", "transform": "uppercase" }
    }
  },

  "spacing": {
    "section-padding-y": "6rem",
    "container-max": "80rem",
    "container-px": "1.5rem",
    "card-padding": "2rem",
    "gap-sm": "0.5rem",
    "gap-md": "1rem",
    "gap-lg": "2rem",
    "gap-xl": "3rem"
  },

  "radius": {
    "sm":   "0.5rem",
    "md":   "0.75rem",
    "lg":   "1rem",
    "xl":   "1.5rem",
    "full": "9999px",
    "button": "9999px",
    "card":   "1rem",
    "input":  "0.5rem"
  },

  "shadow": {
    "sm":   "0 1px 2px 0 rgba(0,0,0,0.05)",
    "md":   "0 4px 6px -1px rgba(0,0,0,0.1)",
    "lg":   "0 10px 15px -3px rgba(0,0,0,0.1)",
    "xl":   "0 20px 25px -5px rgba(0,0,0,0.1), 0 8px 10px -6px rgba(0,0,0,0.1)",
    "glow-teal": "0 8px 24px rgba(10,186,181,0.2)"
  },

  "animation": {
    "duration": {
      "fast":   "150ms",
      "normal": "300ms",
      "slow":   "500ms"
    },
    "easing": {
      "default":  "cubic-bezier(0.4, 0, 0.2, 1)",
      "in":       "cubic-bezier(0.4, 0, 1, 1)",
      "out":      "cubic-bezier(0, 0, 0.2, 1)",
      "snap":     "cubic-bezier(0.16, 1, 0.3, 1)"
    },
    "keyframes": {
      "energy-pulse": "opacity 0.4 → 1 → 0.4, 2s ease-in-out infinite",
      "flow-dash":    "stroke-dashoffset to -40, 2s linear infinite"
    }
  }
}
