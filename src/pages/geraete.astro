  description="Übersicht aller kompatiblen Geräte für PowerShareHome: Wechselrichter, Batteriespeicher, Wallboxen und smarte Steckdosen."
>
  <main class="min-h-screen bg-bg-primary pt-24 pb-16">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h1 class="text-3xl font-bold text-text-primary mb-4">Kompatible Geräte</h1>
      <p class="text-text-secondary text-lg">Diese Seite wird in Kürze verfügbar sein.</p>
    </div>
  </main>
</BaseLayout>
